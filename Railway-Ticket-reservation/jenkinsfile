pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Downloading Railway Reservation source code'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Starting application build'

                sh '''
                test -f Railway-Ticket-reservation/index.html || exit 1
                test -f Railway-Ticket-reservation/style.css || exit 1
                test -f Railway-Ticket-reservation/script.js || exit 1
                echo "Application files verified successfully"
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Testing application files'

                sh '''
                grep -q "<html" Railway-Ticket-reservation/index.html || exit 1
                grep -q "bookingForm" Railway-Ticket-reservation/index.html || exit 1
                grep -q "addEventListener" Railway-Ticket-reservation/script.js || exit 1
                echo "All basic validation tests passed"
                '''
            }
        }

        stage('Package') {
            steps {
                echo 'Creating application package'

                sh '''
                rm -f railway-reservation.zip
                zip -r railway-reservation.zip Railway-Ticket-reservation/index.html Railway-Ticket-reservation/style.css Railway-Ticket-reservation/script.js
                '''
            }
        }
    }

    post {
        success {
            echo 'Railway Reservation Build Successful!'
        }

        failure {
            echo 'Railway Reservation Build Failed!'
        }
    }
}
